{
  "name": "attachments-tools",
  "version": "0.1.0",
  "description": "Read-only reconciliation and on-demand recovery for agent session image attachments: turn a misleading TRANSPORT error into a knowable 'object missing locally' fact, then fetch the missing blobs by sha256. Zero npm dependencies.",
  "keywords": [
    "attachments",
    "sha256",
    "diagnostics",
    "read-only",
    "zstd",
    "session",
    "transport-error",
    "agent"
  ],
  "type": "module",
  "bin": {
    "attachments-audit": "attachments-audit.mjs",
    "attachments-fetch": "attachments-fetch.mjs"
  },
  "files": [
    "attachments-audit.mjs",
    "attachments-fetch.mjs",
    "lib",
    "scripts",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "verify": "node scripts/verify-source.mjs .",
    "test": "node scripts/test-fixtures.mjs",
    "fixtures": "node scripts/test-fixtures.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
